<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net35;net462</TargetFrameworks>
    <OutputType>Library</OutputType>
    <RootNamespace>AssetImport</RootNamespace>
    <LangVersion>7.3</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <Deterministic>true</Deterministic>
    <DebugType>portable</DebugType>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>
  <PropertyGroup Condition="'$(TargetFramework)' == 'net35'">
    <AssemblyName>KK_AssetImport</AssemblyName>
    <DefineConstants>$(DefineConstants);KK</DefineConstants>
  </PropertyGroup>
  <PropertyGroup Condition="'$(TargetFramework)' == 'net462'">
    <AssemblyName>KKS_AssetImport</AssemblyName>
    <DefineConstants>$(DefineConstants);KKS</DefineConstants>
  </PropertyGroup>
  <!-- Game/framework references are compile-only: never distribute game DLLs. -->
  <ItemGroup>
    <EmbeddedResource Include="../../scripts/mmdd/item_morph_functions.py" LogicalName="AssetImport.MmddMorphFunctions.py" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <PackageReference Include="IllusionLibs.BepInEx" Version="5.4.22" ExcludeAssets="runtime" PrivateAssets="all" />
    <PackageReference Include="IllusionLibs.BepInEx.Harmony" Version="2.9.0" ExcludeAssets="runtime" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net35'">
    <PackageReference Include="IllusionLibs.Koikatu.Assembly-CSharp" Version="2019.4.27.4" ExcludeAssets="runtime" PrivateAssets="all" />
    <PackageReference Include="IllusionLibs.Koikatu.Assembly-CSharp-firstpass" Version="2019.4.27.4" ExcludeAssets="runtime" PrivateAssets="all" />
    <PackageReference Include="IllusionLibs.Koikatu.UnityEngine" Version="5.6.2.4" ExcludeAssets="runtime" PrivateAssets="all" />
    <PackageReference Include="IllusionLibs.Koikatu.UnityEngine.UI" Version="5.6.2.4" ExcludeAssets="runtime" PrivateAssets="all" />
    <PackageReference Include="IllusionModdingAPI.KKAPI" Version="1.45.1" ExcludeAssets="runtime" PrivateAssets="all" />
    <PackageReference Include="ExtensibleSaveFormat.Koikatu" Version="19.7.0" ExcludeAssets="runtime" PrivateAssets="all" />
    <PackageReference Include="AssimpNet" Version="5.0.0-beta1" />
    <PackageReference Include="LitJson" Version="0.19.0" />
    <Reference Include="KKABMX" HintPath="../Custom Dependencies/KK/KKABMX.dll" Private="false" />
    <Reference Include="KKPE" HintPath="../Custom Dependencies/KK/KKPE.dll" Private="false" />
    <Reference Include="KK_DynamicBoneEditor" HintPath="../Custom Dependencies/KK/KK_DynamicBoneEditor.dll" Private="false" />
    <Reference Include="KK_MaterialEditor" HintPath="../Custom Dependencies/KK/KK_MaterialEditor.dll" Private="false" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net462'">
    <PackageReference Include="IllusionLibs.KoikatsuSunshine.Assembly-CSharp" Version="2021.9.17" ExcludeAssets="runtime" PrivateAssets="all" />
    <PackageReference Include="IllusionLibs.KoikatsuSunshine.Assembly-CSharp-firstpass" Version="2021.9.17" ExcludeAssets="runtime" PrivateAssets="all" />
    <PackageReference Include="IllusionLibs.KoikatsuSunshine.UniRx" Version="2021.9.17" ExcludeAssets="runtime" PrivateAssets="all" />
    <PackageReference Include="IllusionLibs.KoikatsuSunshine.UniTask" Version="2021.9.17" ExcludeAssets="runtime" PrivateAssets="all" />
    <PackageReference Include="IllusionLibs.KoikatsuSunshine.UnityEngine.CoreModule" Version="2019.4.9" ExcludeAssets="runtime" PrivateAssets="all" />
    <PackageReference Include="IllusionLibs.KoikatsuSunshine.UnityEngine.AnimationModule" Version="2019.4.9" ExcludeAssets="runtime" PrivateAssets="all" />
    <PackageReference Include="IllusionLibs.KoikatsuSunshine.UnityEngine.AssetBundleModule" Version="2019.4.9" ExcludeAssets="runtime" PrivateAssets="all" />
    <PackageReference Include="IllusionLibs.KoikatsuSunshine.UnityEngine.IMGUIModule" Version="2019.4.9" ExcludeAssets="runtime" PrivateAssets="all" />
    <PackageReference Include="IllusionLibs.KoikatsuSunshine.UnityEngine.InputLegacyModule" Version="2019.4.9" ExcludeAssets="runtime" PrivateAssets="all" />
    <PackageReference Include="IllusionLibs.KoikatsuSunshine.UnityEngine.TextRenderingModule" Version="2019.4.9" ExcludeAssets="runtime" PrivateAssets="all" />
    <PackageReference Include="IllusionLibs.KoikatsuSunshine.UnityEngine.UI" Version="2019.4.9" ExcludeAssets="runtime" PrivateAssets="all" />
    <PackageReference Include="IllusionLibs.KoikatsuSunshine.UnityEngine.UIModule" Version="2019.4.9" ExcludeAssets="runtime" PrivateAssets="all" />
    <PackageReference Include="IllusionModdingAPI.KKSAPI" Version="1.43.0" ExcludeAssets="runtime" PrivateAssets="all" />
    <PackageReference Include="ExtensibleSaveFormat.KoikatsuSunshine" Version="19.7.0" ExcludeAssets="runtime" PrivateAssets="all" />
    <PackageReference Include="System.Numerics.Vectors" Version="4.5.0" ExcludeAssets="runtime" PrivateAssets="all" />
    <PackageReference Include="LitJson" Version="0.19.0" />
    <Reference Include="AssimpNetter" HintPath="../Custom Dependencies/AssimpNetter.dll" Private="true" />
    <Reference Include="KKSABMX" HintPath="../Custom Dependencies/KKSABMX.dll" Private="false" />
    <Reference Include="KKSPE" HintPath="../Custom Dependencies/KKSPE.dll" Private="false" />
    <Reference Include="KKS_DynamicBoneEditor" HintPath="../Custom Dependencies/KKS_DynamicBoneEditor.dll" Private="false" />
    <Reference Include="KKS_MaterialEditor" HintPath="../Custom Dependencies/KKS_MaterialEditor.dll" Private="false" />
    <EmbeddedResource Include="Assets/assetimport-resources" />
  </ItemGroup>
  <Target Name="CheckKKReferences" BeforeTargets="ResolveReferences" Condition="'$(TargetFramework)' == 'net35'">
    <Error Condition="!Exists('../Custom Dependencies/KK/KK_MaterialEditor.dll') Or !Exists('../Custom Dependencies/KK/KKPE.dll') Or !Exists('../Custom Dependencies/KK/KKABMX.dll') Or !Exists('../Custom Dependencies/KK/KK_DynamicBoneEditor.dll')" Text="KK build references are missing. Run: python3 scripts/prepare_dependencies.py (from the repository root)." />
  </Target>
  <!-- Keep the numeric plugin/save version stable; identify each test DLL by Git. -->
  <Target Name="StampGitRevision" BeforeTargets="CoreCompile">
    <Exec Command="git rev-parse HEAD" WorkingDirectory="$(MSBuildProjectDirectory)" ConsoleToMSBuild="true" StandardOutputImportance="Low">
      <Output TaskParameter="ConsoleOutput" PropertyName="AssetImportCommit" />
    </Exec>
    <Exec Command="git status --porcelain --untracked-files=normal" WorkingDirectory="$(MSBuildProjectDirectory)" ConsoleToMSBuild="true" StandardOutputImportance="Low">
      <Output TaskParameter="ConsoleOutput" ItemName="AssetImportChanges" />
    </Exec>
    <PropertyGroup>
      <AssetImportDirty Condition="'@(AssetImportChanges->Count())' != '0'">.dirty</AssetImportDirty>
    </PropertyGroup>
    <ItemGroup>
      <AssetImportBuildAttribute Include="System.Reflection.AssemblyInformationalVersionAttribute">
        <_Parameter1>git.$(AssetImportCommit)$(AssetImportDirty)</_Parameter1>
      </AssetImportBuildAttribute>
    </ItemGroup>
    <WriteCodeFragment Language="C#" AssemblyAttributes="@(AssetImportBuildAttribute)" OutputFile="$(IntermediateOutputPath)AssetImport.BuildInfo.g.cs" />
    <ItemGroup>
      <Compile Include="$(IntermediateOutputPath)AssetImport.BuildInfo.g.cs" />
    </ItemGroup>
  </Target>
</Project>

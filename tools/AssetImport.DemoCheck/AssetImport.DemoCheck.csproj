<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFrameworks>net462;net8.0</TargetFrameworks>
    <LangVersion>7.3</LangVersion>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <AssemblyName>AssetImport.DemoCheck</AssemblyName>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <Reference Include="AssimpNet" HintPath="../../src/AssetImport/bin/Release/net35/AssimpNet.dll" Private="true" />
    <Reference Include="LitJSON" HintPath="../../src/AssetImport/bin/Release/net35/LitJSON.dll" Private="true" />
  </ItemGroup>
</Project>
